# Set a unique local password before running Compose. URL-encode it in DATABASE_URL.
POSTGRES_PASSWORD=
DATABASE_URL=
CELERY_BROKER_URL=redis://127.0.0.1:6379/0

# Editorial API is disabled unless explicitly allowed in development/infrastructure.
RW_ENV=production
RW_ADMIN_ENABLED=false
RW_ADMIN_TOKEN=
RW_ADMIN_PREVIOUS_TOKEN=

# Optional worker-only API credential for an approved Himalayas source.
HIMALAYAS_API_KEY=
